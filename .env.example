# MyApproved — Copy to .env.local for local development.
# Never commit .env or .env.local. This file IS committed as a template.

# Database Credentials (Supabase — https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GoHighLevel Integration Keys (LeadConnector API — primary payment & SMS provider)
# GHL uses Stripe as its backend payment processor; customers see "Stripe" on their statements.
GHL_API_KEY=
GHL_LOCATION_ID=

# GoHighLevel payment webhook signature secret — secures app/api/payments/webhook/route.ts.
# Header name + HMAC scheme must match what GHL signs with (see GHL webhook docs).
GHL_WEBHOOK_SECRET=

# Fallback compatibility keys for legacy GHL route
GOHIGHLEVEL_API_KEY=
GOHIGHLEVEL_LOCATION_ID=

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google Analytics 4 (Measurement ID from https://analytics.google.com)
NEXT_PUBLIC_GA_ID=

# DeepSeek API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Google Places API v1 — Server key (https://console.cloud.google.com/apis/credentials)
GOOGLE_SERVER_API_KEY=

# Google reCAPTCHA Enterprise (https://console.cloud.google.com/security/recaptcha)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_PROJECT_ID=

# Companies House API — UK company verification (https://developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=

# Base URL of the app (used for links in emails, canonical URLs, etc.)
NEXT_PUBLIC_APP_URL=

# Admin inbox — receives job post alerts, new tradesperson signups, etc.
ADMIN_EMAIL=

# Outbound email (SMTP)
NOTIFICATION_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Social media URLs — optional. Pages silently omit any whose value is absent.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Aggregate rating/review counts for JSON-LD schema. Leave blank to omit.
NEXT_PUBLIC_AGGREGATE_RATING_VALUE=
NEXT_PUBLIC_AGGREGATE_RATING_COUNT=
NEXT_PUBLIC_AGGREGATE_REVIEW_COUNT=

# Google Maps JavaScript API — client-side (https://console.cloud.google.com/apis/credentials)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Twilio — Optional SMS fallback only (GHL is the primary SMS provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# GoHighLevel OAuth + sync
GOHIGHLEVEL_ACCESS_TOKEN=
GOHIGHLEVEL_CLIENT_ID=
GOHIGHLEVEL_CLIENT_SECRET=
GOHIGHLEVEL_REDIRECT_URI=

# Empire / Fleet — observability ingest
EMPIRE_WEBHOOK_SECRET=
FLEET_INGEST_URL=
FLEET_INGEST_SECRET=

# Cron job secret — secures scheduled API routes
CRON_SECRET=

# Feature flags
ENABLE_AUTO_ASSIGN_JOB=

# Dispute SLA acknowledge window in hours (defaults to 24)
NEXT_PUBLIC_DISPUTE_SLA_ACK_HOURS=

# Customer support email
SUPPORT_EMAIL=

# Server Listen Configuration
PORT=
